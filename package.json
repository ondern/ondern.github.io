{
  "name": "nuray-io-site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Static portfolio for nuray.io (dev tooling only)",
  "scripts": {
    "test:i18n": "node tests/check-i18n.mjs",
    "test:e2e": "node tests/e2e.mjs",
